        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Diagrama de Actividades - Flujo de Cierre Mensual\n\nskinparam monochrome true\nskinparam shadowing false\nskinparam activity {\n    BackgroundColor White\n    BorderColor Black\n    FontColor Black\n}\nskinparam ArrowColor Black\nskinparam NoteBackgroundColor White\nskinparam NoteBorderColor Black\n\nstart\n\n:Definir fecha de corte mensual;\n\n:Obtener movimientos del período;\n\n:Consolidar desembolsos del período;\n\n:Consolidar recuperaciones\n(cobros) por concepto;\n\n:Calcular devengo de interés;\n\n:Actualizar días de atraso\ny marcación de mora;\n\n:Determinar saldo de\ncartera activa;\n\n:Calcular cartera en riesgo\npor tramo;\n\n:Identificar créditos dados\npor incobrables en el período;\n\n:Calcular provisiones;\n\n:Determinar créditos activos;\n\n:Identificar vencimientos próximos;\n\n:Consolidar cifras del\ncierre mensual;\n\nif (¿Existe un cierre para la misma fecha de corte?) then (Sí)\n\n    :Reproducir el mismo\n    resultado del cierre;\n\n    :Evitar duplicación\n    de movimientos;\n\nelse (No)\n\n    :Registrar cierre mensual;\n\n    :Congelar cifras del período\n    según fecha de corte;\n\nendif\n\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EtN-v0ARJStxVAuJ8TzY-1">
